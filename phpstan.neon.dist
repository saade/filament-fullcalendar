parameters:
    level: 4
    paths:
        - src
    excludePaths:
        # Its methods return closures that Livewire binds to the test object,
        # so inside them `$this` is not the class PHPStan sees.
        - src/Testing/TestsCalendar.php
    tmpDir: build/phpstan
    checkOctaneCompatibility: true
    checkModelProperties: true

    ignoreErrors:
        -
            identifier: property.defaultValue
            path: src/Widgets/FullCalendarWidget.php
